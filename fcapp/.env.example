# Database (Docker Compose creates this automatically)
DATABASE_URL="postgresql://fcapp:fcapp_dev_password@localhost:5433/fcapp?schema=public"

# Auth (change JWT_SECRET in production!)
JWT_SECRET="dev-secret-change-in-production-min-32-chars-long"
SESSION_DURATION_DAYS=7

# App
NEXT_PUBLIC_APP_URL="http://localhost:3100"
